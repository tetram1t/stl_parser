NETWORK
TITLE = Stress Network 1

N1_START : NOP 0
A     "Sensor_1"
AN    "Fault"
JC    N1_STOP
L     DB10.DBW0
L     1
+I
T     DB10.DBW0
A(
A     "Sensor_2"
O     "Sensor_3"
)
JC    N1_STOP
CALL FB100

N1_LOOP : NOP 0
L     MW100
L     1
+I
T     MW100
JU    N1_LOOP

N1_STOP : R "MotorEnable"

